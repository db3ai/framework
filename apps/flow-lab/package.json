{
	"name": "flow-lab",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "concurrently --kill-others --names client,server,worker --prefix-colors cyan,magenta,yellow \"npm run client:dev\" \"npm run server:dev\" \"npm run worker:dev\"",
		"client:dev": "vite",
		"server:dev": "node --watch --import tsx server/index.ts",
		"worker:dev": "node scripts/wait-for-api.mjs && node --watch --import tsx server/worker.ts",
		"test": "vitest run",
		"build": "npm run type-check && vite build",
		"type-check": "vue-tsc --noEmit -p tsconfig.json",
		"check": "npm run build"
	},
	"dependencies": {
		"@db3.ai/app": "0.1.0",
		"@db3.ai/flow-designer": "0.1.0",
		"@db3.ai/pure": "0.1.0",
		"@vitejs/plugin-vue": "^6.0.6",
		"dotenv": "^17.4.2",
		"fastify": "^5.8.5",
		"vite": "^8.0.10",
		"vue": "^3.5.33"
	},
	"devDependencies": {
		"@types/node": "^25.9.3",
		"concurrently": "^10.0.3",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"vitest": "^4.1.8",
		"vue-tsc": "^3.3.4"
	}
}
