NODE_ENV=development

# Use a database dedicated to flow-lab so experiments never touch app data.
DB_CLIENT=mysql2
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=platform_flow_lab
DB_USER=root
DB_PASSWORD=

QUEUE_CONNECTION=database
QUEUE_WORKER_INTERVAL_MS=250
QUEUE_RETRY_DELAY_SECONDS=1

FLOW_LAB_API_HOST=127.0.0.1
FLOW_LAB_API_PORT=8788
FLOW_LAB_CLIENT_HOST=127.0.0.1
FLOW_LAB_CLIENT_PORT=5178
