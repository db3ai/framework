{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"skipLibCheck": true,
		"declaration": true,
		"outDir": "dist",
		"rootDir": ".",
		"types": [
			"node"
		]
	},
	"include": [
		"App.ts",
		"server/**/*.ts",
		"shared/**/*.ts",
		"client/index.ts",
		"client/vue.d.ts"
	]
}
