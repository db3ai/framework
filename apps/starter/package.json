{
	"name": "db3-starter",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "node --import tsx scripts/dev.mjs",
		"build": "npm run check && vite build --configLoader runner",
		"start": "tsx server/index.ts",
		"check": "node --import tsx scripts/prepareApps.mjs && vue-tsc --noEmit",
		"test": "vitest run --maxWorkers=1 --configLoader runner",
		"db3": "db3",
		"repl": "db3 repl",
		"db:migrate": "db3 db:migrate",
		"db:check": "db3 db:check",
		"db:make:migration": "npm run check && db3 db:make-migration",
		"queue": "tsx server/queue.ts",
		"scheduler": "tsx server/scheduler.ts"
	},
	"dependencies": {
		"@db3.ai/app": "0.1.0-beta.2",
		"@getdom/studio": "0.1.1",
		"@tiptap/core": "^3.31.3",
		"@tiptap/pm": "^3.31.3",
		"@fastify/cookie": "^11.0.2",
		"@fastify/rate-limit": "^10.3.0",
		"@fastify/static": "^10.1.3",
		"dotenv": "^17.4.2",
		"fastify": "^5.11.3",
		"tsx": "^4.21.0",
		"vue": "^3.5.33",
		"zod": "^4.4.3"
	},
	"overrides": {
		"@tiptap/extension-code-block": "^3.31.3",
		"@tiptap/extension-table": "^3.31.3"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.2.4",
		"@types/node": "^25.9.3",
		"@types/ws": "^8.18.1",
		"@vitejs/plugin-vue": "^6.0.6",
		"tailwindcss": "^4.2.4",
		"typescript": "^6.0.3",
		"vite": "^8.2.1",
		"vitest": "^4.0.18",
		"vue-tsc": "^3.3.4",
		"ws": "^8.21.0"
	}
}
