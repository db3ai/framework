# Local development. NODE_ENV=production enables secure cookies for HTTPS deployment.
APP_NAME="My DB3 app"
APP_ORIGIN=http://localhost:5173
PORT=3001
HOST=127.0.0.1

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db3_app
DB_USER=db3_app
DB_PASSWORD=

# Optional: add your own server-side key. Never prefix secrets with VITE_.
# Leave blank to run registration, login and notes without AI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional Google Identity Services client ID. See README before enabling.
GOOGLE_AUTH_CLIENT_ID=

# Local invitation for the gated collaborative studio. Change before sharing.
DEMO_ROOM_CODE=draw-together

# Separate infrastructure for tests, with CREATE/DROP DATABASE permission.
# Tests create only uniquely named db3_app_test_* databases.
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306
TEST_DB_USER=root
TEST_DB_PASSWORD=

# Account allowed to install, disable and uninstall apps in this single-process Starter.
APP_ADMIN_EMAIL=
# Development defaults to enabled; production requires explicit single-process opt-in.
# APPS_MANAGE_ONLINE=true
