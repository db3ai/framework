{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"lib": [
			"ES2023",
			"DOM",
			"DOM.Iterable"
		],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"types": [
			"node",
			"vite/client"
		]
	},
	"include": [
		"scripts/**/*.ts",
		"server/**/*.ts",
		"src/**/*.ts",
		"src/**/*.vue",
		"tests/**/*.ts",
		"vite.config.ts",
		"index.ts"
	]
}
