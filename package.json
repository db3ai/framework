{
	"name": "db3-framework",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Public source workspace for the db3.ai TypeScript application framework.",
	"license": "MIT",
	"homepage": "https://db3.ai/framework",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/db3ai/framework.git"
	},
	"bugs": {
		"url": "https://github.com/db3ai/framework/issues"
	},
	"engines": {
		"node": ">=24"
	},
	"workspaces": [
		"packages/*",
		"apps/starter",
		"apps/framework",
		"apps/flow-lab",
		"apps/dock"
	],
	"overrides": {
		"@tiptap/core": "3.31.3",
		"@tiptap/extension-blockquote": "3.31.3",
		"@tiptap/extension-bold": "3.31.3",
		"@tiptap/extension-bubble-menu": "3.31.3",
		"@tiptap/extension-bullet-list": "3.31.3",
		"@tiptap/extension-code": "3.31.3",
		"@tiptap/extension-code-block": "3.31.3",
		"@tiptap/extension-collaboration": "3.31.3",
		"@tiptap/extension-collaboration-caret": "3.31.3",
		"@tiptap/extension-document": "3.31.3",
		"@tiptap/extension-dropcursor": "3.31.3",
		"@tiptap/extension-floating-menu": "3.31.3",
		"@tiptap/extension-gapcursor": "3.31.3",
		"@tiptap/extension-hard-break": "3.31.3",
		"@tiptap/extension-heading": "3.31.3",
		"@tiptap/extension-horizontal-rule": "3.31.3",
		"@tiptap/extension-image": "3.31.3",
		"@tiptap/extension-italic": "3.31.3",
		"@tiptap/extension-link": "3.31.3",
		"@tiptap/extension-list": "3.31.3",
		"@tiptap/extension-list-item": "3.31.3",
		"@tiptap/extension-list-keymap": "3.31.3",
		"@tiptap/extension-ordered-list": "3.31.3",
		"@tiptap/extension-paragraph": "3.31.3",
		"@tiptap/extension-placeholder": "3.31.3",
		"@tiptap/extension-strike": "3.31.3",
		"@tiptap/extension-table": "3.31.3",
		"@tiptap/extension-text": "3.31.3",
		"@tiptap/extension-underline": "3.31.3",
		"@tiptap/extensions": "3.31.3",
		"@tiptap/pm": "3.31.3",
		"@tiptap/starter-kit": "3.31.3",
		"@tiptap/vue-3": "3.31.3",
		"@flystorage/stream-mime-type": {
			"file-type": "^21.3.4"
		}
	},
	"scripts": {
		"build": "npm run build --workspaces --if-present",
		"check": "npm run check --workspaces --if-present",
		"test": "npm test --workspaces --if-present",
		"dev:starter": "npm run dev --workspace db3-starter",
		"test:release": "npm test --workspace @db3.ai/pure && npm test --workspace @db3.ai/create && npm run test:release --workspace @db3.ai/app && npm run build --workspace db3-starter && npm test --workspace db3-starter && npm run framework:package:test && npm run framework:create:test && npm run framework:release:test",
		"framework:package": "node scripts/stage-framework-packages.mjs",
		"framework:package:test": "node --test scripts/tests/framework-package-consumer.test.mjs",
		"framework:create:test": "node --env-file-if-exists=packages/app/.env.test --test scripts/tests/framework-create-consumer.test.mjs",
		"framework:release:context": "node scripts/check-framework-release-context.mjs",
		"framework:release:test": "node --test scripts/tests/framework-release-policy.test.mjs",
		"framework:release:prepare": "node scripts/prepare-framework-release.mjs",
		"framework:publish": "node scripts/publish-framework.mjs",
		"framework:publish:test": "node --test scripts/tests/framework-publish.test.mjs scripts/tests/github-framework-release.test.mjs",
		"docs:generate": "npm run generate --workspace @db3.ai/docs",
		"docs:test": "npm test --workspace @db3.ai/docs",
		"docs:build": "npm run build --workspace @db3.ai/docs",
		"docs:dev": "npm run dev --workspace @db3.ai/docs",
		"dev:flow-lab": "npm run dev --workspace flow-lab",
		"dev:dock": "npm run dev --workspace db3-dock",
		"dev:dock:electron": "npm run dev:electron --workspace db3-dock"
	}
}
