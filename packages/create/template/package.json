{
	"name": "db3-starter",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"engines": { "node": ">=24" },
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"build": "npm run check && vite build",
		"start": "tsx server/index.ts",
		"check": "vue-tsc --noEmit",
		"test": "vitest run --maxWorkers=1",
		"db:migrate": "tsx server/database/cli.ts migrate",
		"db:check": "tsx server/database/cli.ts check",
		"db:make:migration": "npm run check && tsx server/database/cli.ts make"
	},
	"dependencies": {
		"@db3.ai/app": "0.1.0",
		"@getdom/studio": "0.1.1",
		"@fastify/cookie": "^11.0.2",
		"@fastify/rate-limit": "^10.3.0",
		"@fastify/static": "^10.1.3",
		"dotenv": "^17.4.2",
		"fastify": "^5.11.3",
		"tsx": "^4.21.0",
		"vue": "^3.5.33"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.2.4",
		"@types/node": "^24.0.0",
		"@vitejs/plugin-vue": "^6.0.6",
		"tailwindcss": "^4.2.4",
		"typescript": "^5.9.3",
		"vite": "^8.2.1",
		"vitest": "^4.0.18",
		"vue-tsc": "^3.2.5"
	}
}
