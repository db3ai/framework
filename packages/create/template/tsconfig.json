{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["node", "vite/client"]
	},
	"include": ["server/**/*.ts", "src/**/*.ts", "src/**/*.vue", "tests/**/*.ts", "vite.config.ts", "database/**/*.ts"]
}
