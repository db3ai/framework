# Copy this file to packages/app/.env.test for local framework tests.
#
# The test runner always forces DB_DATABASE and DB_TEST_DATABASE_PREFIX to
# db3_app_test. Only provide connection credentials here.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=

# Release verification requires a real Redis instance.
QUEUE_REDIS_URL=redis://127.0.0.1:6379
QUEUE_REDIS_PREFIX=db3:test:queue
QUEUE_REDIS_TIMEOUT_MS=1000
